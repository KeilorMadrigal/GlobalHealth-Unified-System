# ============================================================
# GlobalHealth Unified System — variables de entorno
# Copiar a .env y rellenar. NUNCA commitear .env con valores reales.
# ============================================================

# ---- PostgreSQL: maestro ----
PGMASTER_HOST=pg-master
PGMASTER_PORT=5432
PGMASTER_DB=globalhealth
PGMASTER_USER=globalhealth_app
PGMASTER_PASSWORD=changeme_master

# ---- PostgreSQL: réplica (solo lectura) ----
PGREPLICA_HOST=pg-replica
PGREPLICA_PORT=5432
PGREPLICA_DB=globalhealth
PGREPLICA_USER=globalhealth_app
PGREPLICA_PASSWORD=changeme_master

# ---- Rol de replicación (streaming replication) ----
PG_REPLICATION_USER=replicador
PG_REPLICATION_PASSWORD=changeme_replicator
PG_REPLICATION_SLOT=slot_replica_1

# ---- Superusuario de PostgreSQL (solo para inicialización de contenedores) ----
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=changeme_superuser

# ---- Fragmentación: nodos remotos ----
PGNORTE_HOST=pg-norte
PGNORTE_PORT=5432
PGNORTE_DB=globalhealth_norte
PGNORTE_USER=globalhealth_app
PGNORTE_PASSWORD=changeme_norte

PGSUR_HOST=pg-sur
PGSUR_PORT=5432
PGSUR_DB=globalhealth_sur
PGSUR_USER=globalhealth_app
PGSUR_PASSWORD=changeme_sur

# ---- MongoDB Atlas ----
# Formato SRV real, ej: mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net
MONGODB_URI=mongodb+srv://REEMPLAZAR_USUARIO:REEMPLAZAR_PASSWORD@REEMPLAZAR_CLUSTER.mongodb.net
MONGODB_DB=globalhealth

# ---- API ----
API_PORT=3000
NODE_ENV=development
PG_CONNECT_TIMEOUT_MS=2000

# ---- Web ----
WEB_PORT=8080
API_BASE_URL=http://localhost:3000
